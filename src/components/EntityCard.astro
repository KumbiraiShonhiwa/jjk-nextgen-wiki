---
import type { SpoilerLevel } from '../content/schemas';
import Gated from './Gated.astro';
import { LEVEL_LABELS } from '../lib/spoiler';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  meta?: string;
  accent?: string;
  level?: SpoilerLevel;
  /** Show a card-shaped placeholder when hidden, instead of dropping the card (galleries, timelines). */
  redact?: boolean;
  /**
   * Shared-element name for the view transition to this card's page (docs/08 `page-morph`).
   * Only index grids pass it: a name must be unique in a document, and an entity page can list the
   * same entity in two places, which would abort the transition for the whole page.
   */
  transitionName?: string;
}
const { href, title, subtitle, meta, accent, level = 'none', redact = false, transitionName } = Astro.props;
---

<Gated level={level} as="div" silent class="h-full">
  <a
    href={href}
    data-reveal
    data-tilt
    class="card group relative block h-full overflow-hidden rounded-md border border-line bg-ink-2 p-5 shadow-[var(--shadow-1)] transition-colors duration-200 hover:border-[var(--accent)] [transform-style:preserve-3d]"
    style={`--accent:${accent ?? 'var(--ce-blue)'}`}
  >
    <span class="absolute inset-x-0 top-0 h-0.5 bg-[var(--accent)] opacity-70" aria-hidden="true"></span>
    <!-- Always-on accent wash (not just the hover glow), so a grid reads as a cast of people
         rather than a row of identical boxes. Static paint, no animation. -->
    <span
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(180deg, color-mix(in oklab, var(--accent) 8%, transparent), transparent 45%);"
      aria-hidden="true"></span>
    <!-- Cursed-energy sheen. A pre-painted 480px disc (so `closest-side` gives the same 240px
         radius the old `radial-gradient(240px circle at …)` had) parked on the card's top-left
         corner and centred on itself. tiltCard() only *translates* it, so following the pointer
         costs a composited transform instead of repainting a 240px gradient every move. -->
    <span
      data-sheen
      class="card-sheen pointer-events-none absolute top-0 left-0 size-[480px] opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      style="background: radial-gradient(closest-side circle, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);"
      aria-hidden="true"></span>
    <div class="relative mb-4 empty:hidden"><slot name="art" /></div>
    <span class="relative block font-display text-step-2 leading-tight" transition:name={transitionName}>{title}</span>
    {subtitle && <span class="relative mt-1 block text-step--1 text-paper-dim" lang="ja">{subtitle}</span>}
    {meta && <span class="relative mt-4 block text-step--1 uppercase tracking-[0.14em] text-paper-dim">{meta}</span>}
  </a>
</Gated>
{
  redact && level !== 'none' && (
    <div
      data-redacted={level}
      style="--redacted-display: flex"
      class="h-full min-h-28 flex-col justify-between rounded-md border border-dashed border-line p-5 text-paper-dim"
      title={`Hidden: ${LEVEL_LABELS[level].long} spoiler`}
    >
      <span class="font-display text-step-2" aria-hidden="true">▮▮▮▮</span>
      <span class="text-step--1 uppercase tracking-[0.14em]">{LEVEL_LABELS[level].short} spoiler</span>
    </div>
  )
}
