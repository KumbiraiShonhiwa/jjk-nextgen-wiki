---
import type { SpoilerLevel } from '../content/schemas';
import Gated from './Gated.astro';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  meta?: string;
  accent?: string;
  level?: SpoilerLevel;
}
const { href, title, subtitle, meta, accent, level = 'none' } = Astro.props;
---

<Gated level={level} as="div" silent>
  <a
    href={href}
    data-reveal
    data-tilt
    class="card group relative block h-full overflow-hidden rounded-md border border-line bg-ink-2 p-5 shadow-[var(--shadow-1)] transition-colors duration-200 hover:border-[var(--accent)] [transform-style:preserve-3d]"
    style={`--accent:${accent ?? 'var(--ce-blue)'}`}
  >
    <span class="absolute inset-x-0 top-0 h-0.5 bg-[var(--accent)] opacity-70" aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      style="background: radial-gradient(240px circle at var(--glow-x, 50%) var(--glow-y, 50%), color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);"
      aria-hidden="true"></span>
    <span class="relative block font-display text-step-2 leading-tight">{title}</span>
    {subtitle && <span class="relative mt-1 block text-step--1 text-paper-dim" lang="ja">{subtitle}</span>}
    {meta && <span class="relative mt-4 block text-step--1 uppercase tracking-[0.14em] text-paper-dim">{meta}</span>}
  </a>
</Gated>
