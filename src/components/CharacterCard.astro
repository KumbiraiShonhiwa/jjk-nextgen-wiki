---
import type { Character } from '../content/schemas/character';
interface Props { character: Character }
const { character: c } = Astro.props;
const grade = c.grade.find((g) => g.level === 'none')?.value;
---

<a
  href={`/characters/${c.slug}`}
  data-reveal
  class="group relative block overflow-hidden rounded-xl border border-line bg-ink-2 p-5 transition-colors hover:border-[var(--accent)]"
  style={`--accent:${c.accent ?? 'var(--ce-blue)'}`}
>
  <span class="absolute inset-x-0 top-0 h-0.5 bg-[var(--accent)] opacity-70"></span>
  <p class="font-display text-2xl">{c.name.en}</p>
  {c.name.ja && <p class="mt-1 text-sm text-paper-dim" lang="ja">{c.name.ja}</p>}
  {grade && <p class="mt-4 text-xs uppercase tracking-widest text-paper-dim">Grade {grade}</p>}
</a>
