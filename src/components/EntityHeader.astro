---
/** Shared header for entity pages: badges, kinetic title, Japanese name, accent bar. */
interface Props {
  title: string;
  ja?: string;
  eyebrow?: string;
}
const { title, ja, eyebrow } = Astro.props;
---

<header class="mt-8 border-b border-line pb-8">
  <div class="flex flex-wrap gap-2"><slot name="badges" /></div>
  {eyebrow && <p class="mt-6 text-step--1 uppercase tracking-[0.3em] text-[var(--accent)]">{eyebrow}</p>}
  <h1 data-kinetic class="mt-4 font-display text-step-5 leading-none">{title}</h1>
  {ja && <p class="mt-3 text-step-1 text-paper-dim" lang="ja">{ja}</p>}
  <span class="mt-6 block h-1 w-24 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
</header>
