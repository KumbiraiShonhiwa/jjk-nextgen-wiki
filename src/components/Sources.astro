---
import type { Character } from '../content/schemas';

interface Props {
  provenance: Character['provenance'];
  fixture: boolean;
}
const { provenance, fixture } = Astro.props;
const host = { wikipedia: 'Wikipedia', fandom: 'the Jujutsu Kaisen Wiki' } as const;
const licenceUrl = { 'CC BY-SA 4.0': 'https://creativecommons.org/licenses/by-sa/4.0/', 'CC BY-SA 3.0': 'https://creativecommons.org/licenses/by-sa/3.0/' } as const;
const historyUrl = (url: string) => `${url}${url.includes('?') ? '&' : '?'}action=history`;
---

<aside class="mt-16 border-t border-line pt-6 text-step--1 text-paper-dim" aria-label="Sources">
  <h2 class="mb-2 font-semibold uppercase tracking-[0.14em]">Sources</h2>
  {
    fixture || provenance.length === 0 ? (
      <p>Placeholder entry written for the prototype. The content pipeline replaces it with sourced, attributed text.</p>
    ) : (
      <ul class="space-y-1">
        {provenance.map((p) => (
          <li>
            Adapted and restructured from <a class="underline" href={p.url}>{p.title}</a> on {host[p.source]} (
            <a class="underline" href={historyUrl(p.url)}>authors</a>), licensed under{' '}
            <a class="underline" href={licenceUrl[p.licence]}>{p.licence}</a>.
          </li>
        ))}
      </ul>
    )
  }
</aside>
