---
import { NAV } from '../lib/nav';
import SearchPalette from './SearchPalette.svelte';
import SpoilerControl from './SpoilerControl.svelte';

const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line bg-ink/80 backdrop-blur-md">
  <!-- flex-wrap and a tighter gap on small screens: at 390px the logo, search, spoiler control and
     menu together measured 418px, so the control and the menu ran off the right edge. -->
<nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3 sm:gap-x-4" aria-label="Primary">
    <a href="/" class="font-display text-step-1 tracking-wide" aria-label="JJK NextGen Wiki home">
      <span lang="ja">呪術</span><span class="text-paper-dim"> · NextGen</span>
    </a>
    <ul class="hidden items-center gap-5 md:flex">
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={active(item.href) ? 'page' : undefined}
              class="text-step--1 text-paper-dim transition-colors hover:text-paper aria-[current=page]:text-paper"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="ml-auto flex items-center gap-3">
      <SearchPalette client:load />
      <SpoilerControl client:load />
    </div>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-sm border border-line px-2.5 py-1 text-step--1" aria-label="Menu">Menu</summary>
      <ul class="absolute right-0 mt-2 w-48 rounded-md border border-line bg-ink-2 p-2 shadow-[var(--shadow-1)]">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="block rounded-sm px-3 py-2 hover:bg-ink-3">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </nav>
</header>
