---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CharacterCard from '../../components/CharacterCard.astro';

const characters = (await getCollection('characters')).map((e) => e.data).sort((a, b) => a.name.en.localeCompare(b.name.en));
---

<Base title="Characters">
  <section data-cascade class="py-12">
    <h1 class="font-display text-5xl">Characters</h1>
    <p class="mt-2 text-sm text-paper-dim">{characters.length} characters</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {characters.map((c) => <CharacterCard character={c} />)}
    </div>
  </section>
</Base>

<script>
  import { motionScope, revealCascade, showAll } from '../../motion';

  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-cascade]');
    if (el) motionScope(el, ({ reduced }) => (reduced ? showAll(el) : void revealCascade(el)));
  });
</script>
