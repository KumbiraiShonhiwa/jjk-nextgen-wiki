---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { loadIndex } from '../../lib/content';
import { hrefFor, morphName } from '../../lib/routes';

const ix = await loadIndex();
const locations = [...ix.locations.values()].sort((a, b) => a.name.en.localeCompare(b.name.en));
const arcs = [...ix.arcs.values()];
const orgs = [...ix.organizations.values()];

/** Arc and organization counts are the only meta a location has; both are cheap derived counts. */
const countsFor = (slug: string) => ({
  arcs: arcs.filter((a) => a.locations.includes(slug)).length,
  orgs: orgs.filter((o) => o.location === slug).length,
});
const meta = (slug: string) => {
  const { arcs: a, orgs: o } = countsFor(slug);
  return [a ? `${a} ${a === 1 ? 'arc' : 'arcs'}` : null, o ? `${o} ${o === 1 ? 'organization' : 'organizations'}` : null]
    .filter(Boolean)
    .join(' · ');
};
---

<Base title="Locations" description="Where the story of Jujutsu Kaisen takes place.">
  <section data-cascade class="py-12">
    <h1 data-kinetic class="font-display text-step-5 leading-none">Locations</h1>
    <p class="mt-3 text-step--1 text-paper-dim">Where the story takes place</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        locations.map((l) => (
          <EntityCard href={hrefFor('locations', l.slug)} title={l.name.en} subtitle={l.name.ja} meta={meta(l.slug)} level={l.level} transitionName={morphName('locations', l.slug)} redact />
        ))
      }
    </div>
  </section>
</Base>
