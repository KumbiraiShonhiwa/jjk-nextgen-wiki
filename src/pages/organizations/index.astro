---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import { ORGANIZATION_KINDS } from '../../content/schemas';
import { loadIndex } from '../../lib/content';
import { titleCase } from '../../lib/format';
import { membersOf } from '../../lib/graph';
import { hrefFor } from '../../lib/routes';

const ix = await loadIndex();
const orgs = [...ix.organizations.values()].sort(
  (a, b) => ORGANIZATION_KINDS.indexOf(a.kind) - ORGANIZATION_KINDS.indexOf(b.kind) || a.name.en.localeCompare(b.name.en),
);
---

<Base title="Organizations" description="Schools, clans and factions of the Jujutsu Kaisen world.">
  <section data-cascade class="py-12">
    <h1 data-kinetic class="font-display text-step-5 leading-none">Organizations</h1>
    <p class="mt-3 text-step--1 text-paper-dim">Schools, clans and factions</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        orgs.map((o) => {
          const n = membersOf(ix, o.slug).length;
          return (
            <EntityCard
              href={hrefFor('organizations', o.slug)}
              title={o.name.en}
              subtitle={o.name.ja}
              meta={`${titleCase(o.kind)} · ${n} ${n === 1 ? 'member' : 'members'}`}
              level={o.level}
              redact
            />
          );
        })
      }
    </div>
  </section>
</Base>
