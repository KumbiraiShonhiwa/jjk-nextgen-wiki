---
import Base from '../../layouts/Base.astro';
import Gated from '../../components/Gated.astro';
import { LEVEL_LABELS } from '../../lib/spoiler';
import { loadIndex } from '../../lib/content';
import { chapterRange, episodeRange } from '../../lib/format';
import { hrefFor } from '../../lib/routes';

const arcs = [...(await loadIndex()).arcs.values()];
---

<Base title="Story arcs" description="Every story arc of Jujutsu Kaisen in order, with spoilers kept behind your chosen level.">
  <section class="py-12">
    <h1 data-kinetic class="font-display text-step-5 leading-none">Story arcs</h1>
    <p class="mt-3 text-step--1 text-paper-dim">{arcs.length} arcs, in story order</p>

    <!-- Sticky "now reading" label beside the rail. Pure progress feedback for the scrubbed rail,
         so it is aria-hidden and CSS-gated to the full-motion, JS path; the ordered list below is
         the readable content either way. -->
    <div
      data-arc-current
      class="sticky top-20 z-10 mt-10 ml-8 w-fit items-baseline gap-3 rounded-r-sm border-l-2 border-ce-blue bg-ink px-3 py-2 shadow-[var(--shadow-1)]"
      aria-hidden="true"
    >
      <span class="text-step--1 uppercase tracking-[0.3em] text-paper-dim">Now reading</span>
      <span data-arc-current-name class="font-display text-step-1">{arcs[0]?.name}</span>
    </div>

    <ol data-cascade data-timeline class="relative mt-12 space-y-6 pl-8">
      <span class="absolute top-0 bottom-0 left-0 w-px bg-line" aria-hidden="true"></span>
      <span data-rail-fill class="absolute top-0 bottom-0 left-0 w-0.5 origin-top bg-ce-blue" style="transform: scaleY(1)" aria-hidden="true"></span>
      {
        arcs.map((a) => (
          <li data-reveal data-arc={`Arc ${a.order}`} class="relative">
            <span data-marker class="absolute top-2 -left-[2.45rem] size-3 rounded-full border-2 border-ce-blue bg-ink" aria-hidden="true" />
            <p class="text-step--1 uppercase tracking-[0.3em] text-paper-dim">Arc {a.order}</p>
            <Gated level={a.level} as="div">
              <a href={hrefFor('arcs', a.slug)} class="group mt-1 block">
                <span data-arc-name class="font-display text-step-3 group-hover:text-ce-blue">{a.name}</span>
                <span class="mt-1 block text-step--1 text-paper-dim">
                  {[chapterRange(a.chapters), episodeRange(a.episodes)].filter(Boolean).join(' · ')}
                </span>
              </a>
            </Gated>
            {a.level !== 'none' && <span class="sr-only">Unlocks at {LEVEL_LABELS[a.level].long}.</span>}
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  import { arcRail, arcRailStatic, motionScope } from '../../motion';

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLElement>('[data-timeline]');
    if (!list) return;
    // Scope on the parent: the list itself already has the layout's cascade scope.
    const label = document.querySelector<HTMLElement>('[data-arc-current]');
    motionScope(list.parentElement!, ({ reduced }) => (reduced ? arcRailStatic(list) : arcRail(list, label)));
  });
</script>
