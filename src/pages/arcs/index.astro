---
import Base from '../../layouts/Base.astro';
import Gated from '../../components/Gated.astro';
import { LEVEL_LABELS } from '../../lib/spoiler';
import { loadIndex } from '../../lib/content';
import { chapterRange, episodeRange } from '../../lib/format';
import { hrefFor } from '../../lib/routes';

const arcs = [...(await loadIndex()).arcs.values()];
---

<Base title="Story arcs" description="Every story arc of Jujutsu Kaisen in order, with spoilers kept behind your chosen level.">
  <section class="py-12">
    <h1 data-kinetic class="font-display text-step-5 leading-none">Story arcs</h1>
    <p class="mt-3 text-step--1 text-paper-dim">{arcs.length} arcs, in story order</p>

    <ol data-cascade data-timeline class="relative mt-12 space-y-6 border-l border-line pl-8">
      {
        arcs.map((a) => (
          <li data-reveal class="relative">
            <span class="absolute top-2 -left-[2.4rem] size-3 rounded-full border-2 border-ce-blue bg-ink" aria-hidden="true" />
            <p class="text-step--1 uppercase tracking-[0.3em] text-paper-dim">Arc {a.order}</p>
            <Gated level={a.level} as="div">
              <a href={hrefFor('arcs', a.slug)} class="group mt-1 block">
                <span class="font-display text-step-3 group-hover:text-ce-blue">{a.name}</span>
                <span class="mt-1 block text-step--1 text-paper-dim">
                  {[chapterRange(a.chapters), episodeRange(a.episodes)].filter(Boolean).join(' · ')}
                </span>
              </a>
            </Gated>
            {a.level !== 'none' && <span class="sr-only">Unlocks at {LEVEL_LABELS[a.level].long}.</span>}
          </li>
        ))
      }
    </ol>
  </section>
</Base>
