---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const episodes = await getCollection('episodes');
const chapters = await getCollection('chapters');
const seasons = new Set(episodes.map((e) => e.data.season)).size;
const volumes = new Set(chapters.map((c) => c.data.volume)).size;

const cards = [
  { href: '/media/manga', title: 'Manga', meta: `${volumes} volumes · ${chapters.length} chapters`, blurb: 'Every volume, chapter by chapter, with the arc each one covers.' },
  { href: '/media/anime', title: 'Anime', meta: `${seasons} seasons · ${episodes.length} episodes`, blurb: 'Every episode, with its air date and the arc it belongs to.' },
];
---

<Base title="Media" description="The Jujutsu Kaisen manga and anime, arc by arc.">
  <section data-cascade class="py-12">
    <h1 data-kinetic class="font-display text-step-5 leading-none">Media</h1>
    <p class="mt-3 max-w-prose text-paper-dim">The manga and the anime, arc by arc, behind your spoiler level.</p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        cards.map((c) => (
          <a data-reveal href={c.href} class="group block rounded-md border border-line bg-ink-2 p-6 hover:border-ce-blue">
            <span class="block font-display text-step-3 group-hover:text-ce-blue">{c.title}</span>
            <span class="mt-1 block text-step--1 uppercase tracking-[0.14em] text-paper-dim">{c.meta}</span>
            <span class="mt-4 block text-paper-dim">{c.blurb}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
