---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import EntityCard from '../../../../components/EntityCard.astro';
import GatedText from '../../../../components/GatedText.astro';
import Section from '../../../../components/Section.astro';
import Sources from '../../../../components/Sources.astro';
import SpoilerWall from '../../../../components/SpoilerWall.astro';
import { loadIndex } from '../../../../lib/content';
import { characterMeta } from '../../../../lib/format';
import { maxLevel } from '../../../../lib/graph';
import { mentionedIn } from '../../../../lib/mentions';
import { hrefFor } from '../../../../lib/routes';
import { LEVEL_LABELS } from '../../../../lib/spoiler';
import type { Episode } from '../../../../content/schemas';

export async function getStaticPaths() {
  const episodes = (await getCollection('episodes')).map((e) => e.data).sort((a, b) => a.season - b.season || a.numberInSeason - b.numberInSeason);
  return episodes.map((episode) => {
    const inSeason = episodes.filter((e) => e.season === episode.season);
    const index = inSeason.findIndex((e) => e.slug === episode.slug);
    return {
      params: { season: String(episode.season), episode: String(episode.numberInSeason) },
      props: { episode, seasonLength: inSeason.length, previous: inSeason[index - 1], next: inSeason[index + 1] },
    };
  });
}

const { episode: e, seasonLength, previous, next } = Astro.props as {
  episode: Episode;
  seasonLength: number;
  previous?: Episode;
  next?: Episode;
};

const ix = await loadIndex();
const arc = e.arc ? ix.arcs.get(e.arc) : undefined;

/*
 * Who the summary names (roadmap B2). Deliberately not billed as a cast: the only source is two
 * sentences of prose, so a character can be in the episode without being named here.
 */
const summaryText = e.summary.map((s) => s.value).join(' ');
const mentioned = mentionedIn(
  summaryText,
  [...ix.characters.values()].map((c) => ({ slug: c.slug, name: c.name.en, aliases: c.aliases, character: c })),
).map((m) => m.character);

const episodeHref = (other: Episode) => `/media/anime/${other.season}/${other.numberInSeason}`;
---

<Base title={`Season ${e.season}, episode ${e.numberInSeason}`} description={`Episode ${e.numberInSeason} of season ${e.season} of the Jujutsu Kaisen anime.`}>
  <article class="py-12">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href={`/media/anime/${e.season}`} class="text-step--1 text-paper-dim hover:text-paper">← Season {e.season}</a>
      {/*
        Outside the wall on purpose. This is most useful for an episode someone has watched while
        their spoiler level still sits below it, which is exactly when the wall is up. It names no
        content: the wall already says the page is hidden.

        Interim for B1: episode-precise progress does not exist yet, so it sets the level this
        episode sits at, and only ever raises it.
      */}
      <div>
        {/* `data-watched-level`, not `data-level`: the spoiler CSS hides any element carrying a
            `data-level` above the reader's setting, so the button would hide itself on exactly the
            episodes it exists for. */}
        <button type="button" data-watched data-watched-level={e.level} class="rounded-full border border-line px-4 py-1.5 text-step--1 hover:border-ce-blue hover:text-paper">
          I've watched this
        </button>
        <span data-watched-note hidden class="ml-3 text-step--1 text-paper-dim">
          Spoiler level set to {LEVEL_LABELS[e.level].short}.
        </span>
      </div>
    </div>
    <SpoilerWall level={e.level} type="Episode">
      <header class="mt-8 border-b border-line pb-8">
        <p class="text-step--1 uppercase tracking-[0.3em] text-ce-blue">
          Season {e.season} · Episode {e.numberInSeason} of {seasonLength}
        </p>
        <h1 data-kinetic class="mt-4 font-display text-step-4 leading-none">{e.title.en}</h1>
        {e.title.ja && <p class="mt-3 text-step-1 text-paper-dim" lang="ja">{e.title.ja}</p>}
        <p class="mt-3 text-step--1 text-paper-dim">
          {e.airedAt}
          {arc && (
            <>
              {' · '}
              <a class="underline-offset-4 hover:text-paper hover:underline" href={hrefFor('arcs', arc.slug)}>{arc.name}</a>
            </>
          )}
        </p>

      </header>

      <div class="mt-10">
        <GatedText values={e.summary} glossary class="max-w-prose space-y-4 text-step-1 leading-relaxed" />

        {
          mentioned.length > 0 && (
            <Section id="mentioned" title="Named in this summary">
              <p class="text-step--1 text-paper-dim">
                Taken from the summary text, so it is who it names rather than everyone who appears.
              </p>
              <div data-cascade class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {mentioned.map((c) => (
                  <EntityCard
                    href={hrefFor('characters', c.slug)}
                    title={c.name.en}
                    subtitle={c.name.ja}
                    meta={characterMeta(c)}
                    accent={c.accent}
                    level={maxLevel(c.level, e.level)}
                  />
                ))}
              </div>
            </Section>
          )
        }

        <nav class="mt-16 flex flex-wrap justify-between gap-4 border-t border-line pt-6 text-step--1" aria-label="Episodes">
          {
            previous ? (
              <a class="hover:text-paper" href={episodeHref(previous)}>← Episode {previous.numberInSeason}</a>
            ) : (
              <span />
            )
          }
          {next && <a class="hover:text-paper" href={episodeHref(next)}>Episode {next.numberInSeason} →</a>}
        </nav>
      </div>

      <Sources provenance={e.provenance} fixture={false} />
    </SpoilerWall>
  </article>
</Base>

<script>
  import { readLevel, setLevel } from '../../../../lib/spoiler';
  import { SPOILER_LEVELS, type SpoilerLevel } from '../../../../content/schemas/common';

  // "I've watched this" raises the spoiler level to the one this episode sits at, and never lowers
  // it: someone further along who revisits an early episode should not be walked backwards.
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('[data-watched]');
    const note = document.querySelector<HTMLElement>('[data-watched-note]');
    if (!button) return;
    button.addEventListener('click', () => {
      const target = button.dataset.watchedLevel as SpoilerLevel;
      if (SPOILER_LEVELS.indexOf(target) > SPOILER_LEVELS.indexOf(readLevel())) setLevel(target);
      note?.removeAttribute('hidden');
    });
  });
</script>
