---
import Base from '../../layouts/Base.astro';
import Gated from '../../components/Gated.astro';
import { loadIndex } from '../../lib/content';
import { chapterRange } from '../../lib/format';
import { hrefFor } from '../../lib/routes';

const arcs = [...(await loadIndex()).arcs.values()].filter((a) => a.chapters).sort((a, b) => a.chapters![0] - b.chapters![0]);
const lastChapter = Math.max(...arcs.map((a) => a.chapters![1]));

/*
 * Chapters are shown as the ranges the arcs already record. Per-chapter and per-volume pages
 * (A1's other half) need Wikipedia's chapter list, which the ingest does not read yet, and
 * inventing volume boundaries here would be making up content.
 */
const widthOf = (a: (typeof arcs)[number]) => ((a.chapters![1] - a.chapters![0] + 1) / lastChapter) * 100;
---

<Base title="Manga" description="Every arc of the Jujutsu Kaisen manga in chapter order, kept behind your spoiler level.">
  <section class="py-12">
    <p class="text-step--1 uppercase tracking-[0.3em] text-paper-dim">Media</p>
    <h1 data-kinetic class="mt-2 font-display text-step-5 leading-none">Manga</h1>
    <p class="mt-3 max-w-prose text-paper-dim">
      {lastChapter} chapters, by arc. Arcs past your spoiler level stay hidden.
    </p>

    <ol data-cascade class="mt-12 space-y-3">
      {
        arcs.map((a) => (
          <Gated level={a.level} as="li">
            <a data-reveal href={hrefFor('arcs', a.slug)} class="group block rounded-sm border border-line px-4 py-3 hover:border-ce-blue">
              <span class="flex flex-wrap items-baseline justify-between gap-x-4">
                <span class="font-display text-step-1 group-hover:text-ce-blue">{a.name}</span>
                <span class="text-step--1 text-paper-dim">{chapterRange(a.chapters)}</span>
              </span>
              {/* Share of the run so far, so the shape of the series is readable at a glance. */}
              <span class="mt-2 block h-1 rounded-full bg-ink-3" aria-hidden="true">
                <span class="block h-full rounded-full bg-ce-blue/70" style={`width:${widthOf(a).toFixed(1)}%`} />
              </span>
            </a>
          </Gated>
        ))
      }
    </ol>

    <p class="mt-16 max-w-prose text-step--1 text-paper-dim">
      Per-chapter and per-volume pages are not built yet: they need Wikipedia's chapter list, which
      the ingest does not read yet (roadmap A1).
    </p>
  </section>
</Base>
