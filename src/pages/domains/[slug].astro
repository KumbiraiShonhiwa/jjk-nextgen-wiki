---
import Base from '../../layouts/Base.astro';
import EntityCard from '../../components/EntityCard.astro';
import Gated from '../../components/Gated.astro';
import GatedText from '../../components/GatedText.astro';
import Section from '../../components/Section.astro';
import Sources from '../../components/Sources.astro';
import SpoilerWall from '../../components/SpoilerWall.astro';
import { loadIndex } from '../../lib/content';
import { characterMeta } from '../../lib/format';
import { maxLevel } from '../../lib/graph';
import { domainTitle, hrefFor } from '../../lib/routes';
import type { Domain } from '../../content/schemas';

export async function getStaticPaths() {
  const ix = await loadIndex();
  return [...ix.domains.values()].map((domain) => ({ params: { slug: domain.slug }, props: { domain } }));
}

const { domain: d } = Astro.props as { domain: Domain };
const ix = await loadIndex();
const user = ix.characters.get(d.user)!;
const technique = d.technique ? ix.techniques.get(d.technique) : undefined;
const [deep, glow] = d.palette ?? ['#0b0b10', user.accent ?? '#7cc4ff'];
---

<Base title={domainTitle(d)} description="A Domain Expansion in the Jujutsu Kaisen encyclopedia.">
  <article class="py-12" style={`--accent:${glow};--domain-deep:${deep};--domain-glow:${glow}`}>
    <a href="/domains" class="text-step--1 text-paper-dim hover:text-paper">← Domains</a>
    <SpoilerWall level={d.level} type="Domain">
      <header
        data-domain-hero
        class="relative mt-8 grid min-h-[60dvh] place-items-center overflow-hidden rounded-lg border border-line p-8 text-center text-[#f4f1ea]"
        style="background: radial-gradient(120% 90% at 50% 40%, color-mix(in oklab, var(--domain-glow) 28%, var(--domain-deep)), var(--domain-deep) 70%);"
      >
        <span data-domain-ring class="pointer-events-none absolute aspect-square w-[70%] rounded-full border border-[var(--domain-glow)] opacity-30" aria-hidden="true"></span>
        <div class="relative">
          <p class="text-step--1 uppercase tracking-[0.4em] text-[var(--domain-glow)]">Domain Expansion</p>
          <h1 data-kinetic class="mt-4 font-display text-step-5 leading-none">{d.name.en}</h1>
          {d.name.ja && <p class="mt-4 text-step-2 opacity-80" lang="ja">{d.name.ja}</p>}
          <button
            type="button"
            data-takeover-open
            class="mt-8 rounded-full border border-[var(--domain-glow)] px-6 py-2 text-step--1 uppercase tracking-[0.3em] transition-colors hover:bg-[color-mix(in_oklab,var(--domain-glow)_20%,transparent)]"
          >
            Expand the domain
          </button>
        </div>
      </header>

      <dialog
        data-takeover
        data-pagefind-ignore="all"
        aria-label={`Domain Expansion: ${d.name.en}`}
        class="m-0 size-full max-h-none max-w-none overflow-hidden border-0 bg-[var(--domain-deep)] p-0 text-[#f4f1ea] backdrop:bg-transparent"
        style={`--domain-deep:${deep};--domain-glow:${glow}`}
      >
        <button type="button" data-takeover-close class="absolute inset-0 z-10 size-full cursor-pointer" aria-label="Close and return to the page"></button>
        <div class="pointer-events-none absolute inset-0 grid place-items-center">
          {
            [92, 70, 48, 28].map((w) => (
              <span data-takeover-ring class="absolute aspect-square rounded-full border border-[var(--domain-glow)]" style={`width:min(${w}vmin,${w * 1.4}vh);opacity:${0.18 + (100 - w) / 160}`} aria-hidden="true" />
            ))
          }
          <div class="relative text-center">
            <p class="text-step--1 uppercase tracking-[0.5em] text-[var(--domain-glow)]">Domain Expansion</p>
            <p data-takeover-name class="mt-4 font-display text-step-5 leading-none">{d.name.en}</p>
            {d.name.ja && <p data-takeover-ja class="mt-5 text-step-3 opacity-90" lang="ja">{d.name.ja}</p>}
            <p data-takeover-hint class="mt-12 text-step--1">Click or press Esc to return</p>
          </div>
        </div>
      </dialog>

      <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <div>
          <GatedText values={d.summary} class="max-w-prose space-y-4 text-step-1 leading-relaxed" />
          {
            d.sureHit.length > 0 && (
              <Section id="sure-hit" title="Sure-hit effect">
                <GatedText values={d.sureHit} class="max-w-prose space-y-4 border-l-2 border-[var(--accent)] pl-5 leading-relaxed" />
              </Section>
            )
          }
          {
            technique && (
              <Section id="technique" title="Built on">
                <Gated level={technique.level} as="div">
                  <a href={hrefFor('techniques', technique.slug)} class="font-display text-step-2 underline decoration-[var(--accent)] underline-offset-4">
                    {technique.name.en}
                  </a>
                </Gated>
              </Section>
            )
          }
        </div>
        <aside>
          <Section id="user" title="User" class="">
            <EntityCard href={hrefFor('characters', user.slug)} title={user.name.en} subtitle={user.name.ja} meta={characterMeta(user)} accent={user.accent} level={maxLevel(user.level, d.level)} />
          </Section>
        </aside>
      </div>

      <Sources provenance={d.provenance} fixture={d.fixture} />
    </SpoilerWall>
  </article>
</Base>

<script>
  import { prefersReducedMotion, playTakeover, type Takeover } from '../../motion';

  document.addEventListener('astro:page-load', () => {
    const dialog = document.querySelector<HTMLDialogElement>('[data-takeover]');
    const opener = document.querySelector<HTMLButtonElement>('[data-takeover-open]');
    if (!dialog || !opener) return;

    let active: Takeover | undefined;
    const close = () => dialog.open && dialog.close();

    opener.addEventListener('click', (e) => {
      // Keyboard activation reports 0,0: iris from the button's centre instead.
      const r = opener.getBoundingClientRect();
      const origin = e.clientX || e.clientY ? { x: e.clientX, y: e.clientY } : { x: r.left + r.width / 2, y: r.top + r.height / 2 };
      dialog.showModal();
      // Reduced motion: no iris, rings or letter animation; the overlay simply appears.
      if (!prefersReducedMotion()) active = playTakeover(dialog, origin);
    });

    dialog.querySelector('[data-takeover-close]')!.addEventListener('click', close);
    dialog.addEventListener('close', () => {
      active?.cleanup();
      active = undefined;
      dialog.style.clipPath = '';
      opener.focus();
    });
    // Leaving the page by View Transition must not leave the modal open.
    document.addEventListener('astro:before-swap', close, { once: true });
  });
</script>
