---
import Base from '../layouts/Base.astro';
import { NAV } from '../lib/nav';
---

<Base title="Not found" description="This page does not exist.">
  <section class="grid min-h-[60dvh] place-content-center py-16 text-center">
    <p class="text-step--1 uppercase tracking-[0.4em] text-ce-red">404</p>
    <h1 data-kinetic class="mt-4 font-display text-step-5 leading-none">Exorcised</h1>
    <p class="mt-6 text-paper-dim">This page does not exist, or it moved. Try one of these instead.</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {NAV.map((item) => <li><a href={item.href} class="inline-block rounded-full border border-line px-4 py-1.5 hover:border-ce-blue">{item.label}</a></li>)}
    </ul>
  </section>
</Base>
